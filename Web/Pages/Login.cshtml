@page
@model QuanLyBanDienThoai.Web.Pages.LoginModel
<!DOCTYPE html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Đăng nhập Admin</title><link rel="stylesheet" href="~/site.css"></head><body><main><section class="card"><h1>Đăng nhập quản trị</h1><p>Chỉ tài khoản Admin của cửa hàng mới có quyền quản lý hãng điện thoại.</p>@if(Model.Loi != null){<p class="error" role="alert">@Model.Loi</p>}<form method="post"><label>Tên đăng nhập <input asp-for="TenDangNhap" autocomplete="username" required></label><label>Mật khẩu <input asp-for="MatKhau" type="password" autocomplete="current-password" required></label><button type="submit">Đăng nhập</button></form></section></main></body></html>
